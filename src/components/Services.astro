---
import { visibleCategories as categories } from '../lib/services';
import Icon from './Icon.astro';
import AlternateAddresses from './AlternateAddresses.astro';
import { hostnameParts } from '../lib/hostname';
---

{categories.map(category => (
  <section class:list={['service-category', category.cssClass]}>
    <h2 class="section-heading">
      <Icon name={category.icon} /> {category.label}
      <span class="service-count">({category.services.length})</span>
    </h2>
    <div class:list={['service-list', { 'private-list': 'allPrivate' in category && category.allPrivate }]}>
      {category.services.map(service => (
        <div class="service-entry">
        <a
          href={service.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['service-item', { private: ('allPrivate' in category && category.allPrivate) || ('private' in service && service.private) }]}
        >
          <Icon name={service.icon} />
          <span class="service-identity">
            <span class="service-name">{service.name}</span>
            <span class="service-hostname"><span class="service-subdomain">{hostnameParts(service.url).prefix}</span>{hostnameParts(service.url).suffix}</span>
          </span>
          {(('allPrivate' in category && category.allPrivate) || ('private' in service && service.private)) && <Icon name="lock" class="lock-icon" />}
          <span class="service-desc">{service.desc}</span>
        </a>
        {service.alternates && service.alternates.length > 0 && <AlternateAddresses addresses={service.alternates} primary={service.url} />}
        </div>
      ))}
    </div>
  </section>
))}
